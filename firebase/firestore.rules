rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    // Two ways to be an admin:
    // 1) Primary admins — hardcoded here, keep in sync with ADMIN_EMAILS
    //    in firebase-config.js.
    // 2) Team admins — invited from the Team page in /admin, stored in the
    //    `admins` collection below with status "active".
    //
    // Both checks require a VERIFIED email. Without email_verified, anyone
    // could register an admin address that doesn't have a Firebase Auth
    // account yet (email/password signup doesn't prove ownership) and walk
    // straight in.
    //
    // ⚠ BEFORE YOU DEPLOY THIS: every admin account must already be
    // verified in Firebase Auth, or it gets locked out. Check the primary
    // admin in the Auth console, and add a sendEmailVerification() call to
    // inviteTeammate() in js/admin-team.js — it currently creates teammate
    // accounts with createTeammateAccount() and never verifies them.
    // If you'd rather not deal with that yet, drop the email_verified line
    // from authEmail() and revisit it before launch.
    function authEmail() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        ? request.auth.token.email : '';
    }
    function isPrimaryAdmin() {
      return authEmail() in [
        'ahmadrehan0353@gmail.com'
        // add more primary admins here, e.g.:
        // , 'teammate@gmail.com'
      ];
    }
    function isTeamAdmin() {
      return authEmail() != ''
        && exists(/databases/$(database)/documents/admins/$(authEmail()))
        && get(/databases/$(database)/documents/admins/$(authEmail())).data.status == 'active';
    }
    function isAdmin() { return isPrimaryAdmin() || isTeamAdmin(); }
    function signedIn() { return request.auth != null; }
    function isStr(v, maxLen) { return v is string && v.size() > 0 && v.size() <= maxLen; }
    function changed(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---- ADMINS: the invited-teammate list. Only existing admins can
    // view it; only owners (primary admins) add, activate, or remove
    // teammates from the Team page. ----
    match /admins/{email} {
      allow read:  if isAdmin();
      allow write: if isPrimaryAdmin();
    }

    // ---- PRODUCTS: public read, admin write ----
    match /products/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        // Checkout decrements stock as a guest/customer places an order —
        // this is the ONLY write a non-admin can ever make here, and it's
        // scoped tight: only `stock` may change, it can only go down, it
        // can never go below zero, and one call can't move it by more than
        // 20 units. There's no backend to verify a real order happened, so
        // a determined visitor can still walk stock down to 0 in a loop —
        // treat the number as advisory, not as inventory truth.
        changed(['stock'])
        && resource.data.stock is int
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
        && resource.data.stock - request.resource.data.stock <= 20
      );
    }

    // ---- CATEGORIES, BRANDS, QUALITIES & BANNERS: public read, admin write ----
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /brands/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /qualities/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /banners/{id}    { allow read: if true; allow write: if isAdmin(); }

    // ---- COUPONS: public read (checkout validates client-side), admin write.
    // NOTE: public read means every code in this collection is readable by
    // anyone who opens the console — don't park unlaunched or staff-only
    // codes here. ----
    match /coupons/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        // Checkout bumps the usage count by exactly 1 after a real order —
        // the only write a non-admin can make, and nothing else on the
        // coupon (value, expiry, limit, active) can change this way.
        // Same caveat as stock: nothing proves an order happened, so a
        // limited coupon can be burned down by repeated calls.
        changed(['used'])
        && resource.data.used is int
        && request.resource.data.used is int
        && request.resource.data.used == resource.data.used + 1
      );
    }

    // ---- SETTINGS: store name/contact/shipping/tax — public read (storefront
    // footer needs it), admin write. Public read = never put API keys, SMTP
    // credentials or anything secret in here. ----
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // ---- USERS: a person reads/writes only their own profile; admin reads/manages all ----
    match /users/{uid} {
      allow read:   if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
                    && isStr(request.resource.data.email, 200)
                    && request.resource.data.role == 'customer';
      // A person may only touch their own display fields. Without hasOnly,
      // they can rewrite `role` or flip their own `banned` flag back to
      // false. Note the ban is still only enforced by logIn() in the
      // browser — for a real ban, disable the account in Firebase Auth.
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && changed(['name', 'addresses'])
      );
      allow delete: if isAdmin();
    }

    // ---- ORDERS: guest or customer creates; customer reads/lists own; admin manages all ----
    match /orders/{id} {
      // Guests can place orders (cash on delivery). A signed-in customer's
      // order must belong to them. Status/total are validated either way so
      // nobody can create an order that's already "delivered", and a few
      // basic shape checks keep random junk documents out of the collection.
      // What rules CANNOT check: that totals.total matches the items, or
      // that the prices in `items` are the real ones. Always re-price the
      // order against /products before you dispatch it.
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.totals.total is number
                    && request.resource.data.totals.total >= 0
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50
                    && request.resource.data.address is map
                    && request.resource.data.createdAt == request.time
                    && (
                         (request.auth != null && request.resource.data.uid == request.auth.uid)
                      || (request.auth == null && request.resource.data.uid == 'guest')
                    );

      // "get" = fetching ONE order by its exact id. This is what lets a
      // guest track their order without an account, and it is ONLY safe if
      // the id is long and random. A short code (e.g. 1 letter + 4 digits =
      // 260,000 possibilities) can be brute-forced in minutes, and every
      // hit returns a customer's name, address and phone number. Keep
      // makeOrderCode() at 12+ chars from a wide alphabet.
      allow get: if true;

      // "list" = querying the collection. This must NEVER be public, or
      // anyone could dump every order in the store. Admins see all; a
      // signed-in customer may only query their own (uid == their uid).
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    // ---- REVIEWS: admin-managed today (the storefront's review form is
    // local-only), but this stays open to a future signed-in customer
    // submission flow: pending on create, public once approved. ----
    match /reviews/{id} {
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == request.auth.uid   // ties the review to a person
        && isStr(request.resource.data.text, 2000)
        && isStr(request.resource.data.name, 120)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
      );
      // Reminder: rules are filters-that-aren't. A storefront query must be
      // .where('status', '==', 'approved') or the whole query is rejected.
      allow read:   if isAdmin() || resource.data.status == 'approved';
      allow update, delete: if isAdmin();
    }
  }
}
